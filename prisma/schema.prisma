generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  mentor
  judge
  volunteer
}

enum City {
  medellin
  bogota
  both
}

enum Edition {
  v1
  v2
}

enum ApplicationStatus {
  pending
  approved
  rejected
}

enum TechnicalLevel {
  highly_technical
  moderate
  business_focused
}

enum VolunteerAvailability {
  event_day
  pre_event
  both
}

model Application {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  role Role

  fullName  String  @map("full_name")
  email     String
  phone     String?
  linkedin  String?
  twitter   String?
  instagram String?
  telegram  String?
  whatsapp  String?

  city         City
  edition      Edition @default(v2)
  availability String?

  // Mentor-specific fields
  mentorPrimarySkills          String[] @default([]) @map("mentor_primary_skills")
  mentorMonadExperience        Boolean? @map("mentor_monad_experience")
  mentorMonadExperienceDetails String?  @map("mentor_monad_experience_details")
  mentorBlockchainExperience   String?  @map("mentor_blockchain_experience")
  mentorNonTechnicalSkills     String[] @default([]) @map("mentor_non_technical_skills")
  mentorPreviousExperience     Boolean? @map("mentor_previous_experience")
  mentorPreviousDetails        String?  @map("mentor_previous_details")
  mentorBio                    String?  @map("mentor_bio")
  mentorWhy                    String?  @map("mentor_why")
  mentorTeamCommitment         String?  @map("mentor_team_commitment")

  // Judge-specific fields
  judgeCurrentRole        String?          @map("judge_current_role")
  judgeYearsBlockchain    Int?             @map("judge_years_blockchain")
  judgeYearsTotal         Int?             @map("judge_years_total")
  judgeBio                String?          @map("judge_bio")
  judgeTechnicalLevel     TechnicalLevel?  @map("judge_technical_level")
  judgeExpertiseAreas     String[]         @map("judge_expertise_areas")
  judgeSpecificExperience String[]         @map("judge_specific_experience")
  judgePreviousExperience  Boolean?        @map("judge_previous_experience")
  judgePreviousDetails    String?          @map("judge_previous_details")
  judgeCriteriaRanking    Json?            @map("judge_criteria_ranking")
  judgeConflicts          String?         @map("judge_conflicts")
  judgeOtherConflicts     String?         @map("judge_other_conflicts")
  judgeWhy                String?         @map("judge_why")

  // Volunteer-specific fields
  volunteerAvailability VolunteerAvailability? @map("volunteer_availability")
  volunteerWhy          String?                @map("volunteer_why")

  // Review fields
  status        ApplicationStatus @default(pending)
  confirmed     Boolean           @default(false)
  reviewedAt    DateTime?         @map("reviewed_at")
  reviewedBy    String?           @map("reviewed_by")
  reviewerNotes String?           @map("reviewer_notes")

  @@unique([email, role, edition])
  @@index([status])
  @@index([edition])
  @@index([createdAt(sort: Desc)])
  @@index([role])
  @@index([email])
  @@map("applications")
}

// ---------------------------------------------------------------------------
// Judging (Blitz day rubric)
// ---------------------------------------------------------------------------

enum JudgeArea {
  business
  technical
  creative
  general
}

model JudgeProfile {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  email     String
  name      String
  area      JudgeArea @default(general)
  active    Boolean   @default(true)
  edition   Edition   @default(v2)

  @@unique([email, edition])
  @@map("judge_profiles")
}

model JudgingProject {
  id              String   @id @default(uuid())
  createdAt       DateTime @default(now()) @map("created_at")
  edition         Edition  @default(v2)
  name            String
  team            String?
  description     String?
  repoUrl         String?  @map("repo_url")
  demoUrl         String?  @map("demo_url")
  contractAddress String?  @map("contract_address")
  deployed        Boolean  @default(true)
  bonus           Float    @default(0)
  // Official result decided by the jury (1, 2 or 3; ties allowed). Shown on the public site.
  place           Int?     @map("winner_place")
  tweetUrl        String?  @map("tweet_url")
  imageUrl        String?  @map("image_url")
  category        String?

  scores JudgeScore[]

  @@index([edition])
  @@map("judging_projects")
}

model JudgeScore {
  id         String         @id @default(uuid())
  updatedAt  DateTime       @updatedAt @map("updated_at")
  projectId  String         @map("project_id")
  project    JudgingProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  judgeEmail String         @map("judge_email")
  problem    Float?
  blockchain Float?
  demo       Float?
  creativity Float?
  technical  Float?
  pitch      Float?
  comment    String?

  @@unique([projectId, judgeEmail])
  @@index([judgeEmail])
  @@map("judge_scores")
}

// ---------------------------------------------------------------------------
// Public content per edition, managed in /admin/contenido
// ---------------------------------------------------------------------------

model SitePost {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  edition   Edition  @default(v2)
  url       String
  label     String?
  sortOrder Int      @default(0) @map("sort_order")

  @@index([edition])
  @@map("site_posts")
}

model GalleryPhoto {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  edition   Edition  @default(v2)
  alt       String?
  mime      String
  data      Bytes
  width     Int?
  height    Int?
  sortOrder Int      @default(0) @map("sort_order")

  @@index([edition])
  @@map("gallery_photos")
}
