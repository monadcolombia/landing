DATABASE_URL=postgresql://postgres:password@host:5432/railway
# HMAC secret used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Google OAuth: client ID from Google Cloud Console (public, can be exposed to browser)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Comma-separated allowlist of emails authorized to access /admin via Google login (read access)
ADMIN_ALLOWED_EMAILS=
# Subset of ADMIN_ALLOWED_EMAILS with write permissions (approve, reject, withdraw, reactivate, resend emails)
ADMIN_FULL_ACCESS_EMAILS=
# Resend API key for application notification emails
RESEND_API_KEY=
# Optional: sender address used by Resend. Defaults to onboarding@resend.dev
RESEND_FROM=
